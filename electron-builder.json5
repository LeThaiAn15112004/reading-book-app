// @see - https://www.electron.build/configuration/configuration
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "YourAppID",
  "asar": true,
  "productName": "Readmate Reader",
  "directories": {
    // Build output stays beside the Desktop host, as before spec 009 (Main's APP_ROOT logic is unchanged).
    "output": "source/app/platforms/electron/release/${version}"
  },
  // Spec 009 T051 (research R6): the root package.json is shared with Mobile (its "main" is Expo's entry). The packaged
  // app keeps the pre-009 identity: same name / version (app.getVersion() drives the update check) and Main's entry.
  "extraMetadata": {
    "name": "reading-book-desktop",
    "version": "0.0.0",
    "main": "source/app/platforms/electron/dist-electron/main.js"
  },
  "files": [
    // Main resolves APP_ROOT as dist-electron/.., so the host folder layout is kept inside the asar.
    // Its package.json ("type": "module") makes Node load dist-electron/*.js as ES modules, as in dev.
    "source/app/platforms/electron/package.json",
    "source/app/platforms/electron/dist/**",
    "source/app/platforms/electron/dist-electron/**",
    // Typewriter fonts: the PDF writer reads them from {APP_ROOT}/assets/fonts/typewriter at run time (pdf-sync/typewriter-font-files.ts).
    "source/app/platforms/electron/assets/fonts/typewriter/*.ttf",
    "source/app/platforms/electron/assets/fonts/typewriter/OFL.txt",
    "source/app/platforms/electron/assets/fonts/typewriter/THIRD_PARTY_FONTS.md",
    // One manifest holds Desktop AND Mobile dependencies (FR-017): no node_modules except Main's externals
    // (vite.config.ts rollupOptions.external) and their runtime dependencies. Checked by `npm run package`.
    "!node_modules/**",
    // BEGIN main externals (generated by source/scripts/desktop-package-deps.mjs --write)
    "node_modules/@borewit/text-codec/**",
    "node_modules/@huggingface/jinja/**",
    "node_modules/@huggingface/tokenizers/**",
    "node_modules/@huggingface/transformers/**",
    "node_modules/@img/colour/**",
    "node_modules/@img/sharp-darwin-arm64/**",
    "node_modules/@img/sharp-darwin-x64/**",
    "node_modules/@img/sharp-freebsd-wasm32/**",
    "node_modules/@img/sharp-libvips-darwin-arm64/**",
    "node_modules/@img/sharp-libvips-darwin-x64/**",
    "node_modules/@img/sharp-libvips-linux-arm/**",
    "node_modules/@img/sharp-libvips-linux-arm64/**",
    "node_modules/@img/sharp-libvips-linux-ppc64/**",
    "node_modules/@img/sharp-libvips-linux-riscv64/**",
    "node_modules/@img/sharp-libvips-linux-s390x/**",
    "node_modules/@img/sharp-libvips-linux-x64/**",
    "node_modules/@img/sharp-libvips-linuxmusl-arm64/**",
    "node_modules/@img/sharp-libvips-linuxmusl-x64/**",
    "node_modules/@img/sharp-linux-arm/**",
    "node_modules/@img/sharp-linux-arm64/**",
    "node_modules/@img/sharp-linux-ppc64/**",
    "node_modules/@img/sharp-linux-riscv64/**",
    "node_modules/@img/sharp-linux-s390x/**",
    "node_modules/@img/sharp-linux-x64/**",
    "node_modules/@img/sharp-linuxmusl-arm64/**",
    "node_modules/@img/sharp-linuxmusl-x64/**",
    "node_modules/@img/sharp-webcontainers-wasm32/**",
    "node_modules/@img/sharp-win32-arm64/**",
    "node_modules/@img/sharp-win32-ia32/**",
    "node_modules/@img/sharp-win32-x64/**",
    "node_modules/@napi-rs/canvas/**",
    "node_modules/@napi-rs/canvas-android-arm64/**",
    "node_modules/@napi-rs/canvas-darwin-arm64/**",
    "node_modules/@napi-rs/canvas-darwin-x64/**",
    "node_modules/@napi-rs/canvas-linux-arm-gnueabihf/**",
    "node_modules/@napi-rs/canvas-linux-arm64-gnu/**",
    "node_modules/@napi-rs/canvas-linux-arm64-musl/**",
    "node_modules/@napi-rs/canvas-linux-riscv64-gnu/**",
    "node_modules/@napi-rs/canvas-linux-x64-gnu/**",
    "node_modules/@napi-rs/canvas-linux-x64-musl/**",
    "node_modules/@napi-rs/canvas-win32-arm64-msvc/**",
    "node_modules/@napi-rs/canvas-win32-x64-msvc/**",
    "node_modules/@protobufjs/aspromise/**",
    "node_modules/@protobufjs/base64/**",
    "node_modules/@protobufjs/codegen/**",
    "node_modules/@protobufjs/eventemitter/**",
    "node_modules/@protobufjs/fetch/**",
    "node_modules/@protobufjs/float/**",
    "node_modules/@protobufjs/path/**",
    "node_modules/@protobufjs/pool/**",
    "node_modules/@protobufjs/utf8/**",
    "node_modules/@tokenizer/inflate/**",
    "node_modules/@tokenizer/token/**",
    "node_modules/@types/node/**",
    "node_modules/adm-zip/**",
    "node_modules/base64-js/**",
    "node_modules/better-sqlite3/**",
    "node_modules/bindings/**",
    "node_modules/bl/**",
    "node_modules/buffer/**",
    "node_modules/content-type/**",
    "node_modules/debug/**",
    "node_modules/decompress-response/**",
    "node_modules/deep-extend/**",
    "node_modules/define-data-property/**",
    "node_modules/define-properties/**",
    "node_modules/detect-libc/**",
    "node_modules/end-of-stream/**",
    "node_modules/es-define-property/**",
    "node_modules/es-errors/**",
    "node_modules/escape-string-regexp/**",
    "node_modules/expand-template/**",
    "node_modules/file-type/**",
    "node_modules/file-uri-to-path/**",
    "node_modules/flatbuffers/**",
    "node_modules/fs-constants/**",
    "node_modules/github-from-package/**",
    "node_modules/globalthis/**",
    "node_modules/gopd/**",
    "node_modules/guid-typescript/**",
    "node_modules/has-property-descriptors/**",
    "node_modules/ieee754/**",
    "node_modules/inherits/**",
    "node_modules/ini/**",
    "node_modules/long/**",
    "node_modules/media-typer/**",
    "node_modules/minimist/**",
    "node_modules/mkdirp-classic/**",
    "node_modules/ms/**",
    "node_modules/music-metadata/**",
    "node_modules/napi-build-utils/**",
    "node_modules/node-readable-to-web-readable-stream/**",
    "node_modules/object-keys/**",
    "node_modules/once/**",
    "node_modules/onnxruntime-common/**",
    "node_modules/onnxruntime-node/**",
    "node_modules/onnxruntime-web/**",
    "node_modules/pdfjs-dist/**",
    "node_modules/platform/**",
    "node_modules/prebuild-install/**",
    "node_modules/protobufjs/**",
    "node_modules/pump/**",
    "node_modules/rc/**",
    "node_modules/safe-buffer/**",
    "node_modules/sharp/**",
    "node_modules/simple-concat/**",
    "node_modules/simple-get/**",
    "node_modules/string_decoder/**",
    "node_modules/strtok3/**",
    "node_modules/tar-fs/**",
    "node_modules/tar-stream/**",
    "node_modules/token-types/**",
    "node_modules/tunnel-agent/**",
    "node_modules/uint8array-extras/**",
    "node_modules/undici-types/**",
    "node_modules/util-deprecate/**",
    "node_modules/win-guid/**",
    "node_modules/wrappy/**",
    // END main externals
  ],
  // Fails the build when a target that has an entry in electron/transcription/ffmpeg-artifacts.json is packaged
  // without exactly that FFmpeg (see docs/implementation_plan/ffmpeg_packaging.md).
  "afterPack": "source/app/platforms/electron/scripts/ffmpeg/verify-packaged-ffmpeg.mjs",
  "protocols": {
    "name": "Readmate Reader OAuth callback",
    "schemes": [
      "readmate-reader"
    ]
  },
  "mac": {
    "target": [
      "dmg"
    ],
    "artifactName": "${productName}-Mac-${version}-Installer.${ext}"
  },
  "win": {
    // Our own LGPL FFmpeg for transcription, as real files outside the asar: {resources}/ffmpeg/win32-x64/ffmpeg.exe.
    // macOS gets the same entry ("darwin-${arch}") once a Mac build exists; nothing is shipped for macOS / Linux yet.
    "extraResources": [
      {
        "from": "source/app/platforms/electron/resources/ffmpeg/win32-x64",
        "to": "ffmpeg/win32-x64"
      }
    ],
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "${productName}-Windows-${version}-Setup.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  },
  "linux": {
    "target": [
      "AppImage"
    ],
    "artifactName": "${productName}-Linux-${version}.${ext}"
  }
}
