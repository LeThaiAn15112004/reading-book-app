{
  // Expo needs a tsconfig.json at the project root (`npx expo start` writes one if it is missing, spec 009 T018).
  // It covers the React Native host only; the Desktop, WebView UI and core keep their own tsconfig files until US4
  // gives the project one shared base (plan "Project Structure").
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@app/*": ["./source/app/*"],
      "@core": ["./source/core/src/index.ts"],
      "@core/*": ["./source/core/src/*"],
      "@/*": ["./source/app/platforms/native/*"],
      "@/assets/*": ["./source/app/platforms/native/assets/*"]
    }
  },
  "include": [
    "source/app/platforms/native/host/**/*.ts",
    "source/app/platforms/native/routes/**/*.ts",
    "source/app/platforms/native/routes/**/*.tsx",
    "source/app/platforms/native/services/**/*.ts",
    "source/app/platforms/native/env.d.ts",
    "source/app/platforms/native/modules/*/index.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
