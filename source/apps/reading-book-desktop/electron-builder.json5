// @see - https://www.electron.build/configuration/configuration
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "YourAppID",
  "asar": true,
  "productName": "Readmate Reader",
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist",
    "dist-electron",
    // Typewriter fonts: the PDF writer reads them from {app}/assets/fonts/typewriter at run time (electron/pdf-sync/typewriter-font-files.ts).
    "assets/fonts/typewriter/*.ttf",
    "assets/fonts/typewriter/OFL.txt",
    "assets/fonts/typewriter/THIRD_PARTY_FONTS.md"
  ],
  // Fails the build when a target that has an entry in electron/transcription/ffmpeg-artifacts.json is packaged
  // without exactly that FFmpeg (see docs/implementation_plan/ffmpeg_packaging.md).
  "afterPack": "scripts/ffmpeg/verify-packaged-ffmpeg.mjs",
  "protocols": {
    "name": "Readmate Reader OAuth callback",
    "schemes": [
      "readmate-reader"
    ]
  },
  "mac": {
    "target": [
      "dmg"
    ],
    "artifactName": "${productName}-Mac-${version}-Installer.${ext}"
  },
  "win": {
    // Our own LGPL FFmpeg for transcription, as real files outside the asar: {resources}/ffmpeg/win32-x64/ffmpeg.exe.
    // macOS gets the same entry ("darwin-${arch}") once a Mac build exists; nothing is shipped for macOS / Linux yet.
    "extraResources": [
      {
        "from": "resources/ffmpeg/win32-x64",
        "to": "ffmpeg/win32-x64"
      }
    ],
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "${productName}-Windows-${version}-Setup.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  },
  "linux": {
    "target": [
      "AppImage"
    ],
    "artifactName": "${productName}-Linux-${version}.${ext}"
  }
}
