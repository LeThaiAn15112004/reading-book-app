{
  "name": "reading-book-desktop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build && electron-builder",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "postinstall": "electron-builder install-app-deps",
    "rebuild:native": "electron-builder install-app-deps",
    "spike:epub:fixture": "node spikes/epub-engine/build-fixture.mjs",
    "spike:epub:eval": "node spikes/epub-engine/build-fixture.mjs && node spikes/epub-engine/run-node-evals.mjs",
    "spike:overlay:cfi": "node --experimental-strip-types spikes/highlight-overlay/run-cfi-range.mjs",
    "spike:session:roundtrip": "node spikes/session-store/run-roundtrip.mjs",
    "spike:theme:contrast": "node spikes/theme-presets/run-contrast.mjs",
    "spike:signature:fixtures": "node spikes/signature-status/build-fixtures.mjs",
    "spike:signature:status": "node --experimental-strip-types --import ./spikes/signature-status/register-alias.mjs spikes/signature-status/run-signature-status.mjs",
    "spike:settings:reset": "node --experimental-strip-types --import ./spikes/reset-app-settings/register-alias.mjs spikes/reset-app-settings/run-reset-app-settings.mjs",
    "spike:settings:shortcuts": "node --experimental-strip-types --import ./spikes/reset-app-settings/register-alias.mjs spikes/shortcuts/run-shortcuts.mjs",
    "spike:settings:notifications": "node --experimental-strip-types --import ./spikes/reset-app-settings/register-alias.mjs spikes/notifications/run-notifications.mjs",
    "spike:settings:background": "node --experimental-strip-types --import ./spikes/background/register-alias.mjs spikes/background/run-background.mjs",
    "spike:settings:reminders": "node --experimental-strip-types --import ./spikes/background/register-alias.mjs spikes/reminders/run-reminders.mjs",
    "spike:reader:toolbar": "node --experimental-strip-types --import ./spikes/reset-app-settings/register-alias.mjs spikes/reader-toolbar/run-toolbar.mjs",
    "spike:reader:hand": "node --experimental-strip-types --import ./spikes/reset-app-settings/register-alias.mjs spikes/reader-hand/run-hand.mjs",
    "spike:e2e:launch": "vite build && node spikes/e2e-launch/launch.mjs",
    "e2e": "vite build && playwright test -c e2e/playwright.config.ts",
    "e2e:only": "playwright test -c e2e/playwright.config.ts",
    "e2e:txt": "vite build && playwright test -c e2e/playwright.config.ts txt-",
    "e2e:md": "vite build && playwright test -c e2e/playwright.config.ts md-",
    "e2e:typecheck": "tsc --noEmit -p e2e/tsconfig.json",
    "spike:pdf:fixtures": "node spikes/pdf-search/build-fixtures.mjs",
    "spike:pdf:search": "node --experimental-strip-types --import ./spikes/pdf-search/register-alias.mjs spikes/pdf-search/run-pdf-search.mjs",
    "spike:pdf:annotations": "npm run build --prefix ../book-reader-sdk && node --experimental-transform-types --import ./spikes/pdf-annotations/register-alias.mjs spikes/pdf-annotations/run-pdf-annotations.mjs",
    "spike:pdf:embedded": "npm run build --prefix ../book-reader-sdk && node --experimental-transform-types --import ./spikes/pdf-annotations/register-alias.mjs spikes/pdf-annotations/run-pdf-embedded-annotations.mjs",
    "spike:pdf:live": "npm run build --prefix ../book-reader-sdk && node --experimental-transform-types --import ./spikes/pdf-annotations/register-alias.mjs spikes/pdf-annotations/run-pdf-embedded-live.mjs",
    "spike:pdf:ink": "npm run build --prefix ../book-reader-sdk && node --experimental-transform-types --import ./spikes/pdf-annotations/register-alias.mjs spikes/pdf-annotations/run-pdf-ink.mjs",
    "spike:pdf:ink-store": "npm run build --prefix ../book-reader-sdk && node --experimental-transform-types --import ./spikes/txt/register-alias.mjs spikes/pdf-annotations/run-pdf-ink-store.mjs",
    "spike:pdf:graphics": "npm run build --prefix ../book-reader-sdk && node --experimental-transform-types --import ./spikes/pdf-annotations/register-alias.mjs spikes/pdf-annotations/run-pdf-graphics.mjs",
    "spike:pdf:export": "npm run build --prefix ../book-reader-sdk && node --experimental-transform-types --import ./spikes/pdf-annotations/register-alias.mjs spikes/pdf-annotations/run-pdf-annotation-export.mjs",
    "spike:pdf:draw-color": "npm run build --prefix ../book-reader-sdk && node --experimental-transform-types --import ./spikes/txt/register-alias.mjs spikes/pdf-annotations/run-draw-color.mjs",
    "spike:pdf:shape-store": "npm run build --prefix ../book-reader-sdk && node --experimental-transform-types --import ./spikes/txt/register-alias.mjs spikes/pdf-annotations/run-pdf-shape-store.mjs",
    "spike:pdf:shapes": "npm run build --prefix ../book-reader-sdk && node --experimental-transform-types --import ./spikes/pdf-annotations/register-alias.mjs spikes/pdf-annotations/run-pdf-shapes.mjs",
    "spike:pdf:two-way": "npm run build --prefix ../book-reader-sdk && node --experimental-transform-types --import ./spikes/pdf-annotations/register-alias.mjs spikes/pdf-annotations/run-pdf-two-way.mjs",
    "spike:pdf:compat-kit": "npm run build --prefix ../book-reader-sdk && node --experimental-transform-types --import ./spikes/pdf-annotations/register-alias.mjs spikes/pdf-annotations/build-compat-kit.mjs",
    "spike:pdf:attachments": "npm run build --prefix ../book-reader-sdk && node --experimental-transform-types --import ./spikes/txt/register-alias.mjs spikes/attachments/run-pdf-attachments.mjs",
    "spike:txt:main": "npm run build --prefix ../book-reader-sdk && node --experimental-transform-types --import ./spikes/pdf-annotations/register-alias.mjs spikes/txt/run-txt-document.mjs",
    "spike:txt:store": "npm run build --prefix ../book-reader-sdk && node --experimental-transform-types --import ./spikes/txt/register-alias.mjs spikes/txt/run-txt-store.mjs",
    "spike:audio:main": "npm run build --prefix ../book-reader-sdk && node --experimental-transform-types --import ./spikes/pdf-annotations/register-alias.mjs spikes/audio/run-audio-main.mjs",
    "spike:audio:zip": "npm run build --prefix ../book-reader-sdk && node --experimental-transform-types --import ./spikes/pdf-annotations/register-alias.mjs spikes/audio/run-audio-zip.mjs",
    "spike:audio:store": "npm run build --prefix ../book-reader-sdk && node --experimental-transform-types --import ./spikes/txt/register-alias.mjs spikes/audio/run-audio-store.mjs",
    "spike:audio:migration": "node spikes/audio/run-audio-migration.mjs",
    "spike:md:main": "npm run build --prefix ../book-reader-sdk && node --experimental-transform-types --import ./spikes/txt/register-alias.mjs spikes/md/run-md-main.mjs",
    "spike:md:render": "node --experimental-transform-types spikes/md/run-md-render.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "better-sqlite3": "^12.11.1",
    "epubjs": "^0.3.93",
    "fast-xml-parser": "^5.10.1",
    "foliate-js": "^1.0.1",
    "jszip": "^3.10.1",
    "music-metadata": "^12.2.1",
    "pdfjs-dist": "5.4.624",
    "react": "^18.2.0",
    "react-colorful": "^5.8.1",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jszip": "^3.4.0",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@xmldom/xmldom": "^0.9.10",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.2.2",
    "vite": "^8.1.4",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "main": "dist-electron/main.js"
}
