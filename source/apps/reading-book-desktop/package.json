{
  "name": "reading-book-desktop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build && electron-builder",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "postinstall": "electron-builder install-app-deps",
    "rebuild:native": "electron-builder install-app-deps",
    "spike:epub:fixture": "node spikes/epub-engine/build-fixture.mjs",
    "spike:epub:eval": "node spikes/epub-engine/build-fixture.mjs && node spikes/epub-engine/run-node-evals.mjs",
    "spike:overlay:cfi": "node --experimental-strip-types spikes/highlight-overlay/run-cfi-range.mjs",
    "spike:session:roundtrip": "node spikes/session-store/run-roundtrip.mjs",
    "spike:theme:contrast": "node spikes/theme-presets/run-contrast.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "better-sqlite3": "^12.11.1",
    "epubjs": "^0.3.93",
    "fast-xml-parser": "^5.10.1",
    "foliate-js": "^1.0.1",
    "jszip": "^3.10.1",
    "react": "^18.2.0",
    "react-colorful": "^5.8.1",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jszip": "^3.4.0",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@xmldom/xmldom": "^0.9.10",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.2.2",
    "vite": "^8.1.4",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "main": "dist-electron/main.js"
}
