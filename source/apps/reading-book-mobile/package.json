  "scripts": {
    "postinstall": "node ./scripts/link-expo-root.mjs",
    "start": "expo start",
    "dev:web": "vite build --watch --config web/vite.config.ts",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "node ../../node_modules/typescript/bin/tsc -p web/tsconfig.json",
    "build:web": "node ./scripts/build-web.mjs",
    "build:web:feasibility": "node ./scripts/build-web.mjs --feasibility",
