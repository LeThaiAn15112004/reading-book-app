{
  // Declaration-only emit; JS bundles come from rolldown (scripts/build.mjs). Interim until T023 removes the bundle.
  "extends": "../../core/tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "outDir": "dist/types",
    "rootDir": "../../core/src"
  },
  "include": ["../../core/src/**/*.ts"]
}
