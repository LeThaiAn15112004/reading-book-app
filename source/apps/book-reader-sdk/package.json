{
  "name": "@reading-book/book-reader-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Platform-agnostic core of reading-book-app: domain types, CFI utils, EPUB package parsing, annotation logic and zustand (vanilla) stores. All I/O is injected by the host.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false
}
