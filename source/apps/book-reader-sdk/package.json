{
  "name": "@reading-book/book-reader-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Platform-agnostic core of reading-book-app: domain types, CFI utils, EPUB package parsing, annotation logic and zustand (vanilla) stores. All I/O is injected by the host.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:tests": "tsc -p tests/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node scripts/build.mjs",
    "example:node": "node examples/node-host/host.mjs",
    "verify": "npm run typecheck && npm run typecheck:tests && npm test && npm run build && npm run example:node"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "rolldown": "^1.1.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "zustand": "^5.0.15"
  }
}
