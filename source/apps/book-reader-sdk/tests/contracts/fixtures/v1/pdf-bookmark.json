      "label": "Page 7",
      "created": "<timestamp>",
      "modified": "<timestamp>"
    },
    "record": {
      "locator": { "kind": "page-rect", "page": 7, "chapterIndex": 6 },
      "label": "Page 7"
    }
  }
}
