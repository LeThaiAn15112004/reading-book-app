// Desktop renderer + Main typecheck of the shared UI (spec 009 T039, research R4): `moduleSuffixes` makes TypeScript pick `<concern>.electron.ts` the way
// Vite's `resolve.extensions` does. Standalone rather than extending the root tsconfig.json, which is Expo's (React Native base).
{
  "compilerOptions": {
    "paths": {
      "@app/*": [
        "./source/app/*"
      ],
      "@reading-book/config": [
        "./source/core/src/config/index.ts"
      ],
      "@reading-book/config/*": [
        "./source/core/src/config/*"
      ],
      "@reading-book/book-reader-sdk": [
        "./source/core/src/index.ts"
      ],
      "@reading-book/book-reader-sdk/*": [
        "./source/core/src/*"
      ]
    },
    "moduleSuffixes": [
      ".electron",
      ""
    ],
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "./source/app",
    "./source/app/platforms/electron"
  ],
  "exclude": ["./source/app/**/*.native.ts", "./source/app/**/*.native.tsx", "./source/app/platforms/electron/e2e", "./source/app/platforms/electron/spikes", "./source/app/platforms/electron/scripts", "./source/app/platforms/electron/release", "./source/app/platforms/electron/dist", "./source/app/platforms/electron/dist-electron"],
  "references": [
    {
      "path": "./source/app/platforms/electron/tsconfig.node.json"
    }
  ]
}
