    "expo-router": "~57.0.29",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "fast-xml-parser": "^5.10.1",
    "foliate-js": "^1.0.1",
    "jszip": "^3.10.2",
    "music-metadata": "^12.2.1",
    "pdfjs-dist": "5.4.624",
    "react": "19.2.3",
    "react-colorful": "^5.8.1",
