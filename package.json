{
  "name": "reading-book-app",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "cd source/apps/reading-book-desktop && vite",
    "dev:mobile": "npm run build:web && expo start",
    "dev:all": "concurrently -n desktop,mobile -c blue,green \"npm run dev\" \"npm run dev:mobile\"",
    "dev:web": "cd source/apps/reading-book-mobile && vite build --watch --config web/vite.config.ts",
    "build": "cd source/apps/reading-book-desktop && vite build",
    "package": "cd source/apps/reading-book-desktop && tsc --noEmit && vite build && electron-builder",
    "preview": "cd source/apps/reading-book-desktop && vite preview",
    "build:web": "cd source/apps/reading-book-mobile && node ./scripts/build-web.mjs",
    "build:web:feasibility": "cd source/apps/reading-book-mobile && node ./scripts/build-web.mjs --feasibility",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "npm run sdk:typecheck && npm run sdk:typecheck:tests && npm run desktop:typecheck && npm run e2e:typecheck && npm run mobile:typecheck && npm run mobile:typecheck:web",
    "lint": "npm run desktop:lint && npm run mobile:lint",
    "test": "npm run sdk:test && npm run mobile:test",
    "check": "npm run check:single-install && npm run typecheck && npm run lint && npm test && npm run check:boundaries && npm run build && npm run build:web",
    "check:desktop-baseline": "node source/scripts/check-desktop-baseline.mjs",
    "check:boundaries": "node source/scripts/boundaries/run-all.mjs",
    "sdk:typecheck": "tsc -p tsconfig.core.json",
    "sdk:typecheck:tests": "tsc -p source/core/tests/tsconfig.json",
    "sdk:test": "cd source/core && vitest run",
    "sdk:test:watch": "cd source/core && vitest",
    "desktop:typecheck": "cd source/apps/reading-book-desktop && tsc --noEmit",
    "desktop:lint": "cd source/apps/reading-book-desktop && eslint . --max-warnings 0",
    "mobile:typecheck": "cd source/apps/reading-book-mobile && tsc --noEmit",
    "mobile:typecheck:web": "cd source/apps/reading-book-mobile && tsc -p web/tsconfig.json",
    "mobile:lint": "cd source/apps/reading-book-mobile && eslint .",
    "mobile:test": "cd source/apps/reading-book-mobile && vitest run --config web/vitest.config.ts",
    "mobile:feasibility:webkit": "cd source/apps/reading-book-mobile && node ./scripts/feasibility-webkit.mjs",
    "postinstall": "npm run rebuild:native",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3 -m .",
    "spike:epub:fixture": "cd source/apps/reading-book-desktop && node spikes/epub-engine/build-fixture.mjs",
    "spike:epub:eval": "cd source/apps/reading-book-desktop && node spikes/epub-engine/build-fixture.mjs && node spikes/epub-engine/run-node-evals.mjs",
    "spike:overlay:cfi": "cd source/apps/reading-book-desktop && node --experimental-strip-types spikes/highlight-overlay/run-cfi-range.mjs",
    "spike:session:roundtrip": "cd source/apps/reading-book-desktop && node spikes/session-store/run-roundtrip.mjs",
    "spike:theme:contrast": "cd source/apps/reading-book-desktop && node spikes/theme-presets/run-contrast.mjs",
    "spike:signature:fixtures": "cd source/apps/reading-book-desktop && node spikes/signature-status/build-fixtures.mjs",
    "spike:signature:status": "cd source/apps/reading-book-desktop && node --experimental-strip-types --import ./spikes/signature-status/register-alias.mjs spikes/signature-status/run-signature-status.mjs",
    "spike:settings:reset": "cd source/apps/reading-book-desktop && node --experimental-strip-types --import ./spikes/reset-app-settings/register-alias.mjs spikes/reset-app-settings/run-reset-app-settings.mjs",
    "spike:settings:shortcuts": "cd source/apps/reading-book-desktop && node --experimental-strip-types --import ./spikes/reset-app-settings/register-alias.mjs spikes/shortcuts/run-shortcuts.mjs",
    "spike:settings:notifications": "cd source/apps/reading-book-desktop && node --experimental-strip-types --import ./spikes/reset-app-settings/register-alias.mjs spikes/notifications/run-notifications.mjs",
    "spike:settings:background": "cd source/apps/reading-book-desktop && node --experimental-strip-types --import ./spikes/background/register-alias.mjs spikes/background/run-background.mjs",
    "spike:settings:reminders": "cd source/apps/reading-book-desktop && node --experimental-strip-types --import ./spikes/background/register-alias.mjs spikes/reminders/run-reminders.mjs",
    "spike:reader:toolbar": "cd source/apps/reading-book-desktop && node --experimental-strip-types --import ./spikes/reset-app-settings/register-alias.mjs spikes/reader-toolbar/run-toolbar.mjs",
    "spike:reader:hand": "cd source/apps/reading-book-desktop && node --experimental-strip-types --import ./spikes/reset-app-settings/register-alias.mjs spikes/reader-hand/run-hand.mjs",
    "spike:e2e:launch": "cd source/apps/reading-book-desktop && vite build && node spikes/e2e-launch/launch.mjs",
    "e2e": "cd source/apps/reading-book-desktop && vite build && playwright test -c e2e/playwright.config.ts",
    "e2e:only": "cd source/apps/reading-book-desktop && playwright test -c e2e/playwright.config.ts",
    "e2e:txt": "cd source/apps/reading-book-desktop && vite build && playwright test -c e2e/playwright.config.ts txt-",
    "e2e:md": "cd source/apps/reading-book-desktop && vite build && playwright test -c e2e/playwright.config.ts md-",
    "e2e:typecheck": "cd source/apps/reading-book-desktop && tsc --noEmit -p e2e/tsconfig.json",
    "spike:pdf:fixtures": "cd source/apps/reading-book-desktop && node spikes/pdf-search/build-fixtures.mjs",
    "spike:pdf:search": "cd source/apps/reading-book-desktop && node --experimental-strip-types --import ./spikes/pdf-search/register-alias.mjs spikes/pdf-search/run-pdf-search.mjs",
    "spike:pdf:annotations": "cd source/apps/reading-book-desktop && node --experimental-transform-types --import ./spikes/pdf-annotations/register-alias.mjs spikes/pdf-annotations/run-pdf-annotations.mjs",
    "spike:pdf:embedded": "cd source/apps/reading-book-desktop && node --experimental-transform-types --import ./spikes/pdf-annotations/register-alias.mjs spikes/pdf-annotations/run-pdf-embedded-annotations.mjs",
    "spike:pdf:live": "cd source/apps/reading-book-desktop && node --experimental-transform-types --import ./spikes/pdf-annotations/register-alias.mjs spikes/pdf-annotations/run-pdf-embedded-live.mjs",
    "spike:pdf:ink": "cd source/apps/reading-book-desktop && node --experimental-transform-types --import ./spikes/pdf-annotations/register-alias.mjs spikes/pdf-annotations/run-pdf-ink.mjs",
    "spike:pdf:ink-store": "cd source/apps/reading-book-desktop && node --experimental-transform-types --import ./spikes/txt/register-alias.mjs spikes/pdf-annotations/run-pdf-ink-store.mjs",
    "spike:pdf:graphics": "cd source/apps/reading-book-desktop && node --experimental-transform-types --import ./spikes/pdf-annotations/register-alias.mjs spikes/pdf-annotations/run-pdf-graphics.mjs",
    "spike:pdf:export": "cd source/apps/reading-book-desktop && node --experimental-transform-types --import ./spikes/pdf-annotations/register-alias.mjs spikes/pdf-annotations/run-pdf-annotation-export.mjs",
    "spike:pdf:draw-color": "cd source/apps/reading-book-desktop && node --experimental-transform-types --import ./spikes/txt/register-alias.mjs spikes/pdf-annotations/run-draw-color.mjs",
    "spike:pdf:shape-store": "cd source/apps/reading-book-desktop && node --experimental-transform-types --import ./spikes/txt/register-alias.mjs spikes/pdf-annotations/run-pdf-shape-store.mjs",
    "spike:pdf:typewriter-font": "cd source/apps/reading-book-desktop && node --experimental-transform-types --import ./spikes/pdf-annotations/register-alias.mjs spikes/pdf-annotations/run-pdf-typewriter-font.mjs",
    "spike:pdf:typewriter": "cd source/apps/reading-book-desktop && node --experimental-transform-types --import ./spikes/pdf-annotations/register-alias.mjs spikes/pdf-annotations/run-pdf-typewriter.mjs",
    "spike:pdf:typewriter-perf": "cd source/apps/reading-book-desktop && node --experimental-transform-types --import ./spikes/pdf-annotations/register-alias.mjs spikes/pdf-annotations/run-pdf-typewriter-perf.mjs",
    "spike:pdf:typewriter-store": "cd source/apps/reading-book-desktop && node --experimental-transform-types --import ./spikes/txt/register-alias.mjs spikes/pdf-annotations/run-pdf-typewriter-store.mjs",
    "spike:pdf:shapes": "cd source/apps/reading-book-desktop && node --experimental-transform-types --import ./spikes/pdf-annotations/register-alias.mjs spikes/pdf-annotations/run-pdf-shapes.mjs",
    "spike:pdf:two-way": "cd source/apps/reading-book-desktop && node --experimental-transform-types --import ./spikes/pdf-annotations/register-alias.mjs spikes/pdf-annotations/run-pdf-two-way.mjs",
    "spike:pdf:compat-kit": "cd source/apps/reading-book-desktop && node --experimental-transform-types --import ./spikes/pdf-annotations/register-alias.mjs spikes/pdf-annotations/build-compat-kit.mjs",
    "spike:pdf:attachments": "cd source/apps/reading-book-desktop && node --experimental-transform-types --import ./spikes/txt/register-alias.mjs spikes/attachments/run-pdf-attachments.mjs",
    "spike:pdf:attachment-memory": "cd source/apps/reading-book-desktop && node --experimental-transform-types --import ./spikes/txt/register-alias.mjs spikes/attachments/run-pdf-attachment-memory.mjs",
    "spike:pdf:attachment-write": "cd source/apps/reading-book-desktop && node --experimental-transform-types --import ./spikes/pdf-annotations/register-alias.mjs spikes/attachments/run-pdf-attachment-write.mjs",
    "spike:pdf:attachment-store": "cd source/apps/reading-book-desktop && node --experimental-transform-types --import ./spikes/txt/register-alias.mjs spikes/attachments/run-pdf-attachment-store.mjs",
    "spike:txt:main": "cd source/apps/reading-book-desktop && node --experimental-transform-types --import ./spikes/pdf-annotations/register-alias.mjs spikes/txt/run-txt-document.mjs",
    "spike:txt:store": "cd source/apps/reading-book-desktop && node --experimental-transform-types --import ./spikes/txt/register-alias.mjs spikes/txt/run-txt-store.mjs",
    "spike:audio:main": "cd source/apps/reading-book-desktop && node --experimental-transform-types --import ./spikes/pdf-annotations/register-alias.mjs spikes/audio/run-audio-main.mjs",
    "spike:audio:zip": "cd source/apps/reading-book-desktop && node --experimental-transform-types --import ./spikes/pdf-annotations/register-alias.mjs spikes/audio/run-audio-zip.mjs",
    "spike:audio:store": "cd source/apps/reading-book-desktop && node --experimental-transform-types --import ./spikes/txt/register-alias.mjs spikes/audio/run-audio-store.mjs",
    "spike:audio:zip-import": "cd source/apps/reading-book-desktop && node --experimental-transform-types --import ./spikes/pdf-annotations/register-alias.mjs spikes/audio/run-audio-zip-import.mjs",
    "spike:annotations:main": "cd source/apps/reading-book-desktop && node --experimental-transform-types --import ./spikes/pdf-annotations/register-alias.mjs spikes/annotations/run-annotations-main.mjs",
    "spike:annotations:perf": "cd source/apps/reading-book-desktop && node spikes/annotations/run-annotations-perf.mjs",
    "spike:annotations:store": "cd source/apps/reading-book-desktop && node --experimental-transform-types --import ./spikes/txt/register-alias.mjs spikes/annotations/run-annotations-store.mjs",
    "spike:audio:zip-store": "cd source/apps/reading-book-desktop && node --experimental-transform-types --import ./spikes/txt/register-alias.mjs spikes/audio/run-zip-import-store.mjs",
    "spike:audio:chapters": "cd source/apps/reading-book-desktop && node --experimental-transform-types --import ./spikes/pdf-annotations/register-alias.mjs spikes/audio/run-audio-chapters-store.mjs",
    "spike:audio:migration": "cd source/apps/reading-book-desktop && node spikes/audio/run-audio-migration.mjs",
    "spike:transcription:main": "cd source/apps/reading-book-desktop && node spikes/transcription/run-transcription-main.mjs",
    "spike:transcription:store": "cd source/apps/reading-book-desktop && node spikes/transcription/run-transcription-store.mjs",
    "spike:transcription:sidebar": "cd source/apps/reading-book-desktop && node --experimental-transform-types --import ./spikes/txt/register-alias.mjs spikes/transcription/run-transcription-sidebar.mjs",
    "spike:transcription:ffmpeg": "cd source/apps/reading-book-desktop && node spikes/transcription/run-ffmpeg-decoder.mjs",
    "spike:transcription:smoke": "cd source/apps/reading-book-desktop && npx vite build && node spikes/transcription/run-transcription-smoke.mjs",
    "spike:md:main": "cd source/apps/reading-book-desktop && node --experimental-transform-types --import ./spikes/txt/register-alias.mjs spikes/md/run-md-main.mjs",
    "spike:md:render": "cd source/apps/reading-book-desktop && node --experimental-transform-types spikes/md/run-md-render.mjs",
    "spike:contract:fixtures": "cd source/apps/reading-book-desktop && node --experimental-transform-types spikes/mobile-contract-fixtures.mts",
    "check:single-install": "node source/scripts/check-single-install.mjs",
    "clean:old-installs": "node source/scripts/clean-old-installs.mjs"
  },
  "dependencies": {
    "@expo/ui": "~57.0.26",
    "@huggingface/transformers": "^4.3.0",
